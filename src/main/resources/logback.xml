<configuration>
    <property name="PATTERN"
              value="%d{HH:mm:ss.SSS} %highlight(%-5level) %cyan(%logger{0}) %magenta([%X{event:-}%X{ref:- }]) - %msg%n"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATTERN}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

    <!-- Noisy libraries: raise their level rather than filtering messages. -->
    <logger name="io.netty" level="WARN"/>
    <logger name="io.ktor" level="INFO"/>
    <logger name="org.jooq" level="WARN"/>
    <logger name="org.flywaydb" level="INFO"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.example" level="${log.level:-INFO}"/>

    <!-- TODO production: swap the console encoder for JSON
         (net.logstash.logback.encoder.LogstashEncoder) so ref, event and
         outcome become queryable fields instead of text to grep. -->

</configuration>
